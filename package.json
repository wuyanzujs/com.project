{
  "name": "com.project",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "24.13.0",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "dev:app": "pnpm --filter com.deppon.app dev",
    "build:app": "pnpm --filter com.deppon.app build",
    "android": "pnpm --filter com.deppon.app android",
    "ios": "pnpm --filter com.deppon.app ios",
    "start:app": "pnpm --filter com.deppon.app start",
    "typecheck:app": "pnpm --filter com.deppon.app typecheck",
    "lint:app": "pnpm --filter com.deppon.app lint",
    "lint:app:styles": "pnpm --filter com.deppon.app lint:styles",
    "test:app-style-governance": "pnpm --filter com.deppon.app test:style-governance",
    "lint:app:fix": "pnpm --filter com.deppon.app lint:fix",
    "check:app-boundaries": "pnpm --filter com.deppon.app check:rn-boundaries",
    "check:app-styles": "pnpm --filter com.deppon.app check:styles",
    "check:app-styles:strict": "pnpm --filter com.deppon.app check:styles:strict",
    "report:app-styles": "pnpm --filter com.deppon.app check:styles:report",
    "update:app-styles-baseline": "pnpm --filter com.deppon.app update:styles-baseline",
    "check:app-routes": "pnpm --filter com.deppon.app check:routes",
    "check:app-module-size": "pnpm --filter com.deppon.app check:module-size",
    "check:app-barrels": "pnpm --filter com.deppon.app check:barrels",
    "check:app-runtime-config": "pnpm --filter com.deppon.app check:runtime-config",
    "check:app-bundle-size": "pnpm --filter com.deppon.app check:bundle-size",
    "update:app-bundle-size-baseline": "pnpm --filter com.deppon.app update:bundle-size-baseline",
    "check:app-business-rules": "pnpm --filter com.deppon.app check:business-rules",
    "check:app-platform-build": "pnpm --filter com.deppon.app check:platform-build",
    "check:app-native-env": "pnpm --filter com.deppon.app check:native-env",
    "check:app-native-env:all": "pnpm --filter com.deppon.app check:native-env:all",
    "check:app-native-env:android": "pnpm --filter com.deppon.app check:native-env:android",
    "check:app-native-env:ios": "pnpm --filter com.deppon.app check:native-env:ios",
    "format:config": "prettier --write package.json pnpm-workspace.yaml .prettierrc.cjs \".github/**/*.{yml,yaml}\" \"scripts/**/*.{js,cjs,mjs}\" apps/com.deppon.app/package.json \"apps/com.deppon.app/config/**/*.{ts,js,cjs,mjs}\" \"apps/com.deppon.app/scripts/**/*.{js,cjs,mjs}\" apps/com.deppon.app/babel.config.js apps/com.deppon.app/metro.config.js apps/com.deppon.app/.stylelintrc.cjs apps/com.deppon.app/tsconfig.json && prettier --write --parser json apps/com.deppon.app/.eslintrc apps/com.deppon.app/.watchmanconfig",
    "format:config:check": "prettier --check package.json pnpm-workspace.yaml .prettierrc.cjs \".github/**/*.{yml,yaml}\" \"scripts/**/*.{js,cjs,mjs}\" apps/com.deppon.app/package.json \"apps/com.deppon.app/config/**/*.{ts,js,cjs,mjs}\" \"apps/com.deppon.app/scripts/**/*.{js,cjs,mjs}\" apps/com.deppon.app/babel.config.js apps/com.deppon.app/metro.config.js apps/com.deppon.app/.stylelintrc.cjs apps/com.deppon.app/tsconfig.json && prettier --check --parser json apps/com.deppon.app/.eslintrc apps/com.deppon.app/.watchmanconfig",
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "check:repo-config": "node scripts/check-repo-config.mjs",
    "verify:config": "pnpm run check:toolchain && pnpm run format:config:check && pnpm run check:repo-config",
    "verify:app": "pnpm run verify:config && pnpm --filter com.deppon.app verify",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.4"
  },
  "lint-staged": {
    "apps/com.deppon.app/src/**/*.{ts,tsx,js,cjs,mjs}": [
      "pnpm --filter com.deppon.app exec eslint --fix",
      "prettier --write"
    ],
    "apps/com.deppon.app/config/**/*.{ts,tsx,js,cjs,mjs}": [
      "pnpm --filter com.deppon.app exec eslint --fix",
      "prettier --write"
    ],
    "apps/com.deppon.app/scripts/**/*.{ts,tsx,js,cjs,mjs}": [
      "pnpm --filter com.deppon.app exec eslint --fix",
      "prettier --write"
    ],
    "apps/com.deppon.app/src/**/*.scss": [
      "pnpm --filter com.deppon.app exec stylelint --fix",
      "prettier --write"
    ],
    "**/*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "{.prettierrc.cjs,apps/com.deppon.app/{babel.config.js,metro.config.js,.stylelintrc.cjs,.watchmanconfig}}": [
      "prettier --write"
    ]
  }
}
