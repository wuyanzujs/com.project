{
  "extends": ["taro/react"],
  "rules": {
    "react/jsx-uses-react": "off",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}", "config/**/*.{ts,js,cjs,mjs}", "scripts/**/*.{js,cjs,mjs}"],
      "env": {
        "node": true,
        "es2022": true
      },
      "parser": "@typescript-eslint/parser",
      "plugins": ["@typescript-eslint", "app"],
      "rules": {
        "app/no-direct-react-native": ["error", { "allow": ["/src/shared/native/", "/src/shared/platform/"] }],
        "app/no-taro-platform-api": ["error", { "allow": ["/src/shared/platform/", "/src/shared/native/"] }],
        "app/no-page-business-decisions": [
          "warn",
          {
            "files": ["/src/pages/"],
            "allow": [
              { "file": "/src/pages/login/index.tsx", "name": "canSend", "reason": "登录表单纯 UI 可用性（会话态 + 本地输入 + 倒计时）" },
              { "file": "/src/pages/login/index.tsx", "name": "canSubmit", "reason": "登录表单纯 UI 可用性（会话态 + 本地输入 + 协议勾选）" },
              { "file": "/src/pages/express/components/ExpressContactPanel/index.tsx", "name": "canSwap", "reason": "寄收件地址齐全后的纯 UI 入口开关" },
              { "file": "/src/pages/express/components/ExpressCouponCard/index.tsx", "name": "isCouponHighlighted", "reason": "优惠券卡片纯 UI 高亮态" },
              { "file": "/src/pages/order/edit/components/OrderEditInsuranceSection/index.tsx", "name": "canClear", "reason": "保价金额表单的纯 UI 可清空态" },
              {
                "file": "/src/pages/order/detail/orderDetailViewModel.ts",
                "name": "isPublicOrderTrackMode",
                "reason": "路由参数派生的公开物流态，与服务端字段无关"
              }
            ]
          }
        ],
        "app/no-service-api-import": "error",
        "app/required-import-source": [
          "error",
          {
            "files": ["/src/shared/native/AppSessionCookie.ts"],
            "source": "@react-native-cookies/cookies"
          }
        ],
        "app/required-component-source": [
          "error",
          {
            "files": ["/src/pages/login/index.tsx"],
            "name": "AppFormScrollView",
            "source": "@/shared/native"
          }
        ],
        "semi": ["error", "never"],
        "quotes": ["error", "single", { "avoidEscape": true }],
        "jsx-quotes": ["error", "prefer-single"],
        "comma-dangle": ["error", "never"],
        "react/jsx-closing-bracket-location": [
          "error",
          {
            "nonEmpty": "line-aligned",
            "selfClosing": "line-aligned"
          }
        ],
        "import/order": [
          "error",
          {
            "groups": ["builtin", "external", "internal", ["parent", "sibling", "index"], "type"],
            "pathGroups": [
              {
                "pattern": "react",
                "group": "external",
                "position": "before"
              },
              {
                "pattern": "@tarojs/**",
                "group": "external",
                "position": "after"
              },
              {
                "pattern": "@/**",
                "group": "internal",
                "position": "after"
              }
            ],
            "pathGroupsExcludedImportTypes": ["builtin"],
            "newlines-between": "always",
            "alphabetize": {
              "order": "asc",
              "caseInsensitive": true
            }
          }
        ],
        "max-len": [
          "warn",
          {
            "code": 160,
            "ignoreComments": true,
            "ignoreStrings": true,
            "ignoreTemplateLiterals": true,
            "ignoreUrls": true
          }
        ]
      }
    },
    {
      "files": ["config/**/*.{js,cjs}", "scripts/**/*.{js,cjs}", "*.config.js", "*.cjs"],
      "env": {
        "node": true
      },
      "rules": {
        "import/no-commonjs": "off"
      }
    }
  ]
}
