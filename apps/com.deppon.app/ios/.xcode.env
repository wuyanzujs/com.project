# This `.xcode.env` file is versioned and is used to source the environment
# used when running script phases inside Xcode.
# To customize your local environment, you can create an `.xcode.env.local`
# file that is not versioned.

# NODE_BINARY can be set in the environment or resolved from PATH.
# The version must match the workspace pin when Xcode provides SRCROOT/PODS_ROOT.
export NODE_BINARY="${NODE_BINARY:-$(command -v node || true)}"

if [ -z "${NODE_BINARY}" ] || [ ! -x "${NODE_BINARY}" ]; then
  echo "NODE_BINARY must point to an executable Node binary." >&2
  exit 1
fi

# Locate the repo `.node-version` by walking UP from the build root. Pod script
# phases (e.g. hermes-engine) run with SRCROOT pointing at `ios/Pods`, while the
# app target uses `ios`, so a fixed parent depth breaks one of them. Ascending
# until we find the file works for both and for any monorepo nesting depth.
search_dir=""
if [ -n "${SRCROOT:-}" ]; then
  search_dir="${SRCROOT}"
elif [ -n "${PODS_ROOT:-}" ]; then
  search_dir="${PODS_ROOT}"
fi

if [ -n "${search_dir}" ]; then
  node_version_file=""
  dir="${search_dir}"
  while [ -n "${dir}" ] && [ "${dir}" != "/" ]; do
    if [ -f "${dir}/.node-version" ]; then
      node_version_file="${dir}/.node-version"
      break
    fi
    dir=$(dirname "${dir}")
  done

  if [ -n "${node_version_file}" ]; then
    expected_node_version=$(tr -d "\r\n" < "${node_version_file}")
    actual_node_version=$("${NODE_BINARY}" --version 2>/dev/null || true)
    actual_node_version=${actual_node_version#v}

    if [ "${actual_node_version}" != "${expected_node_version}" ]; then
      # `.xcode.env` is sourced BEFORE `.xcode.env.local`, so NODE_BINARY here may
      # still be the PATH-resolved node (Xcode's GUI PATH rarely includes fnm/nvm),
      # not the pinned one that `.xcode.env.local` sets afterwards. Warn instead of
      # aborting so that local override can supply the correct Node for the actual
      # build/codegen/hermes steps. Hard-failing here breaks every machine whose
      # default node differs from the pin.
      echo "warning: .xcode.env sees Node ${actual_node_version:-unavailable}; workspace pins ${expected_node_version}. Ensure ios/.xcode.env.local points NODE_BINARY at Node ${expected_node_version}." >&2
    fi
  fi
fi
